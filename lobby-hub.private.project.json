{
  "name": "SlugshotLobbyHub",
  "serveAddress": "127.0.0.1",
  "servePort": 34879,
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FallenPartsDestroyHeight": -2000
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": false
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "MovementExperiment": {
        "$path": "experiments/movement/shared"
      },
      "MovementPrivateClips": {
        "$path": "private-assets/generated/MovementClips.luau"
      },
      "LobbyScale": {
        "$path": "experiments/lobby/scale/shared"
      },
      "LookPack": {
        "$path": "experiments/lobby/shared/LookPack.luau"
      },
      "Combat": {
        "$path": "experiments/combat/shared"
      },
      "GooArt": {
        "$path": "private-assets/ui/GooArt.luau"
      },
      "InfernoAsset": {
        "$path": "private-assets/inferno/InfernoAsset.luau"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      },
      "MovementSandbox": {
        "$path": "build/lobby-scale/generated/server",
        "Arena": {
          "$path": "experiments/lobby/scale/server/Arena.luau"
        },
        "LobbySpawns": {
          "$path": "experiments/lobby/scale/server/LobbySpawns.luau"
        }
      },
      "HubArt": {
        "$path": "experiments/lobby/hub/server/HubArt.server.luau"
      },
      "FloppyAppearance": {
        "$path": "experiments/creatures/floppy/server/FloppyAppearance.luau"
      },
      "InfernoAppearance": {
        "$path": "experiments/creatures/inferno/server/InfernoAppearance.luau"
      },
      "LobbySettings": {
        "$className": "Folder",
        "SettingsPersistence": {
          "$path": "experiments/combat/server/SettingsPersistence.server.luau"
        },
        "SettingsStore": {
          "$path": "experiments/combat/server/SettingsStore.luau"
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        },
        "MovementSandbox": {
          "$path": "experiments/movement/client"
        },
        "LobbyScale": {
          "$path": "experiments/lobby/scale/client"
        },
        "HubMotion": {
          "$path": "experiments/lobby/hub/client/HubMotion.client.luau"
        },
        "GroveSlugs": {
          "$path": "experiments/lobby/hub/client/GroveSlugs.client.luau"
        },
        "GroveWater": {
          "$path": "experiments/lobby/hub/client/GroveWater.client.luau"
        },
        "Combat": {
          "$className": "Folder",
          "FloppyRecovery": {
            "$path": "experiments/combat/client/FloppyRecovery.luau"
          },
          "Goo": {
            "$path": "experiments/combat/client/Goo.luau"
          },
          "GooBar": {
            "$path": "experiments/combat/client/GooBar.luau"
          },
          "PvpFx": {
            "$path": "experiments/combat/client/PvpFx.luau"
          },
          "PvpTheme": {
            "$path": "experiments/combat/client/PvpTheme.luau"
          },
          "SettingsSync": {
            "$path": "experiments/combat/client/SettingsSync.luau"
          },
          "SlugIcon": {
            "$path": "experiments/combat/client/SlugIcon.luau"
          },
          "SlugVisuals": {
            "$path": "experiments/combat/client/SlugVisuals.luau"
          },
          "Settings": {
            "$path": "experiments/combat/client/Settings.client.luau"
          }
        },
        "LobbyFirstPerson": {
          "$path": "experiments/lobby/hub/client/LobbyFirstPerson.client.luau"
        },
        "GroveFloppyFace": {
          "$path": "experiments/creatures/floppy/client/FloppyFace.client.luau"
        },
        "GroveInfernoMotion": {
          "$path": "experiments/creatures/inferno/client/InfernoMotion.client.luau"
        }
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "HubAssets": {
        "$path": "private-assets/lobby/HubAssets.luau"
      },
      "HubMaterials": {
        "$path": "private-assets/lobby/hub_materials.rbxmx"
      },
      "FloppyAsset": {
        "$path": "private-assets/floppy/FloppyAsset.luau"
      },
      "FloppyMaterials": {
        "$path": "private-assets/floppy/materials.rbxmx"
      },
      "InfernoAsset": {
        "$path": "private-assets/inferno/InfernoAsset.luau"
      },
      "InfernoMaterials": {
        "$path": "private-assets/inferno/materials.rbxmx"
      },
      "LobbyAssets": {
        "$path": "private-assets/lobby/LobbyAssets.luau"
      },
      "LobbyMaterials": {
        "$path": "private-assets/lobby/materials.rbxmx"
      }
    }
  }
}
